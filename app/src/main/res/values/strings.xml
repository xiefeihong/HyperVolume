    <!-- ==================== 应用与模块元信息 ==================== -->
    <string name="app_name">HyperVolume</string>
    <string name="app_subtitle">蓝牙/有线/外放独立配档位</string>
    <string name="module_description">自定义媒体音量档位（10~100）与音量键步进（10~29），并提供蓝牙绝对/相对/默认三种音量控制模式与系统真实曲线查看。</string>
    <string name="xposed_description">自定义媒体音量档位（10~100）与音量键步进（10~29），并提供两种音量控制模式。</string>

